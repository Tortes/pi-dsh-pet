{
  "name": "pi-dsh-pet",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Pi desktop pet using Rust + Tauri.",
  "type": "module",
  "files": [
    "pi",
    "dsh-pet/assets",
    "src-tauri"
  ],
  "scripts": {
    "pet:dev": "node scripts/create-icon.mjs && tauri dev",
    "pet:build": "node scripts/create-icon.mjs && tauri build",
    "pet:check": "node --check pi/monitor/server.mjs && node --experimental-strip-types --check pi/extensions/index.ts"
  },
  "pi": {
    "extensions": [
      "./pi/extensions"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  },
  "license": "MIT"
}
